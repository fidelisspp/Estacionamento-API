            "description": "Público. Faz login como ADMIN e salva o token em {{token}}. O token expira em 2 minutos: ao receber 401, rode de novo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana@email.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
