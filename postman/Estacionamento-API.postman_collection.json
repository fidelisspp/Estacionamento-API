              "raw": "{\n  \"placa\": \"ABC-1234\",\n  \"marca\": \"FIAT\",\n  \"modelo\": \"PALIO 1.0\",\n  \"cor\": \"AZUL\",\n  \"clienteCpf\": \"{{cpf}}\",\n  \"servicosIds\": [{{servicoId}}]\n}",
