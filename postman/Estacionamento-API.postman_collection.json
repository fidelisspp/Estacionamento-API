                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "    console.log(\"token = \" + pm.collectionVariables.get(\"token\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE (salva o token)",
          "request": {
            "method": "POST",
