            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Público. Faz login como CLIENTE (Maria) e salva o token em {{token}}. Use antes das requisições marcadas como CLIENTE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"maria@email.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
